<div class="scroll"><table><thead><tr><th>Заявка</th><th>Дата</th><th>Владелец</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>
{% for r in rows %}<tr><td><a href="expense.php?id={{ r.id }}">{{ r.title }}</a><small>{{ r.category_name }} · {{ r.merchant }}</small></td><td>{{ r.expense_date|date('d.m.Y',false) }}</td><td>{{ r.full_name }}<small>{{ r.department }}</small></td><td class="money">{{ r.amount|currency }}</td><td><span class="status {{ r.status }}">{{ statuses[r.status] }}</span></td></tr>
{% else %}<tr><td colspan="5">Заявок не найдено.</td></tr>{% endfor %}</tbody></table></div>