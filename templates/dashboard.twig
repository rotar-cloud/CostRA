{% extends 'layout.twig' %}{% block content %}{% include 'month.twig' %}<div class="cards kpis"><article>{% include 'icon.twig' with {icon:'expenses'} only %}<small>{{ admin?'Всего заявок':'Мои заявки' }}</small><h2>{{ total }}</h2></article>{% for k in ['approved','pending','rejected'] %}<article>{% include 'icon.twig' with {icon:k} only %}<small>{{ statuses[k] }}</small><h2>{{ k=='rejected'?counts[k]:totals[k]|default('0')|currency }}</h2></article>{% endfor %}</div>
<div class="charts"><section class="panel"><h2>Статусы заявок</h2><div class="chartbody"><div class="ring" style="--a:{{ total?100*counts.approved/total:0 }}%;--b:{{ total?100*(counts.approved+counts.pending)/total:0 }}%;--end:{{ total?'var(--red)':'var(--line)' }}"><strong>{{ total }}</strong></div><div class="legend">{% for k,s in statuses %}<p><span class="dot {{ k }}"></span>{{ s }} <strong>{{ counts[k] }}</strong></p>{% endfor %}</div></div></section>
<section class="panel"><h2>Одобренные расходы отделов</h2>{% set peak=max(budgets|map(b=>b.approved)|merge([1])) %}{% for b in budgets %}<small>{{ b.name }} · {{ b.approved|currency }}</small><progress aria-label="Одобренные расходы {{ b.name }} относительно наибольшей суммы" value="{{ b.approved }}" max="{{ peak }}"></progress>{% endfor %}</section></div>
<h2>Бюджеты подразделений</h2>{% include 'budget-table.twig' %}<h2>Последние заявки</h2>{% include 'table.twig' %}{% endblock %}