{% extends 'layout.twig' %}{% block content %}{% include 'month.twig' %}{% include 'budget-table.twig' %}
{% if admin %}<form method="post" class="filters">{% include 'csrf.twig' %}<label>Месяц лимита<input required type="month" name="month" value="{{ month }}"></label><label>Подразделение<select name="department_id">{% for d in departments %}<option value="{{ d.id }}">{{ d.name }}</option>{% endfor %}</select></label><label>Лимит, MDL<input required type="number" step=".01" min=".01" max="9999999999.99" name="amount"></label><button>Сохранить лимит</button></form>{% endif %}{% endblock %}