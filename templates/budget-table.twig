<div class="scroll"><table><tr><th>Отдел</th><th>Лимит</th><th>Одобрено</th><th>Ожидает</th><th>Остаток</th></tr>{% for b in budgets %}<tr><td>{{ b.name }}</td><td>{{ b.amount is null?'Не задан':b.amount|currency }}</td><td>{{ b.approved|currency }}{% if b.amount %}{% include 'meter.twig' with {percent:b.percent,over:b.remaining<0} only %}<small>{{ b.percent }}%</small>{% endif %}</td><td>{{ b.pending|currency }}</td><td class="{{ b.remaining<0?'error' }}">{{ b.remaining is null?'—':b.remaining|currency }}{% if b.remaining<0 %}<small>Превышение бюджета</small>{% endif %}</td></tr>{% endfor %}</table></div>